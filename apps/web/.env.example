# API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Server-to-server auth shared with the Express API (same value in apps/api/.env)
INTERNAL_API_KEY=

# Yellowstone gRPC (Pulse / per-token live charts) — Allnodes/PublicNode
GRPC_ENDPOINT=https://solana-yellowstone-grpc.publicnode.com:443
GRPC_TOKEN=your_grpc_token

# Standard Solana RPC + WS (token data feed, swaps)
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
SOLANA_WS_URL=wss://solana-rpc.publicnode.com

# Crossmint onramp (Buy with card / Apple Pay)
# Server key scopes: orders.create, orders.read (staging keys: staging.crossmint.com/console)
CROSSMINT_SERVER_SIDE_API_KEY=
NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY=
