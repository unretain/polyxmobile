# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pumplab"

# Redis (optional - will use in-memory cache if not provided)
REDIS_URL="redis://localhost:6379"

# API Keys
BIRDEYE_API_KEY="your_birdeye_api_key"
HELIUS_API_KEY="your_helius_api_key"
MORALIS_API_KEY="your_moralis_api_key"

# Server
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Server-to-server auth shared with the Next.js app (same value in apps/web/.env)
INTERNAL_API_KEY=

# Yellowstone gRPC (Pulse feed) — Allnodes/PublicNode
GRPC_ENDPOINT=https://solana-yellowstone-grpc.publicnode.com:443
GRPC_TOKEN=your_grpc_token

# Standard Solana RPC (graduation checks, token data)
SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Public origin of THIS api service — stamped into coin logo URLs (/img?u=...)
PUBLIC_API_URL=
